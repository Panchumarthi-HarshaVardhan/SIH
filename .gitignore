# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Python virtual environment
.venv/
venv/
ENV/
env/

# Environment variables
.env
.env.*
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Node.js / React
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / Editor specific files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Data & Model artifacts (exclude actual data files, keep directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
ml/datasets/*
!ml/datasets/.gitkeep
ml/models/*
!ml/models/.gitkeep

# Satellite generated images and binary model weights
data/satellite/cache/*
!data/satellite/cache/.gitkeep
data/satellite/raw/*
!data/satellite/raw/.gitkeep
data/satellite/processed/*
!data/satellite/processed/.gitkeep
data/satellite/non_fire/*
!data/satellite/non_fire/.gitkeep
data/satellite/natural_fire/*
!data/satellite/natural_fire/.gitkeep
data/satellite/industrial_fire/*
!data/satellite/industrial_fire/.gitkeep
data/satellite/persistent_thermal/*
!data/satellite/persistent_thermal/.gitkeep
*.pth
*.npz
*.zip

# ML Satellite Dataset (Keep manifests, reports, scripts, .gitkeeps; ignore large samples/raw/processed)
backend/data/ml/satellite/raw/*
!backend/data/ml/satellite/raw/.gitkeep
backend/data/ml/satellite/processed/*
!backend/data/ml/satellite/processed/.gitkeep
backend/data/ml/satellite/samples/*
!backend/data/ml/satellite/samples/.gitkeep

