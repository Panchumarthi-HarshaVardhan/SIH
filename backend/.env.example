# NASA FIRMS API Key (Get your key at: https://firms.modaps.eosdis.nasa.gov/api/map_key)
NASA_FIRMS_MAP_KEY=

# Automated Ingestion Polling Interval (in minutes)
FIRMS_INGEST_INTERVAL_MINUTES=10

# Database Connection URL (Optional - defaults to local file storage if empty)
DATABASE_URL=

# CORS Allowed Origins (Comma-separated URLs for frontend clients)
CORS_ORIGINS=http://localhost:5173

# Alert Thresholds & State Machine
ALERT_CRITICAL_THRESHOLD=75.0
ALERT_HIGH_THRESHOLD=50.0
ALERT_DEDUP_RADIUS_KM=1.0
ALERT_COOLDOWN_HOURS=12.0

# Phase 4 Copernicus Sentinel Hub Satellite Image Intelligence (Sentinel-2 L2A)
# Get credentials at: https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
SATELLITE_SEARCH_WINDOW_HOURS=48
SATELLITE_MAX_CLOUD_COVER=80.0

# Phase 6A Satellite ML Dataset Construction
SATELLITE_DATASET_TARGET_WILDFIRE=400
SATELLITE_DATASET_TARGET_INDUSTRIAL=250
SATELLITE_DATASET_TARGET_NON_FIRE=400
INDUSTRIAL_CANDIDATE_RADIUS_KM=2.0
MIN_FIRMS_CONFIDENCE=0.5
MIN_FRP=10.0
MAX_CLOUD_FOR_TRAINING=60.0
ML_PATCH_SIZE=128
ML_PATCH_RADIUS_KM=1.0

# Phase 8 & 9 Satellite Image Cache & Dimensions
SATELLITE_PROVIDER=Sentinel-2
SATELLITE_IMAGE_SIZE=256
SATELLITE_PATCH_RADIUS_KM=1.0
SATELLITE_CACHE_DIR=data/satellite/cache
SATELLITE_DATASET_DIR=data/satellite

# Phase 9 Trainable Computer Vision Model Configuration
SATELLITE_CLASSIFIER=trained
SATELLITE_MODEL_DIR=models/satellite_classifier
SATELLITE_METRICS_DIR=data/satellite/metrics

# Supabase Authentication & PostgreSQL Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here


